%% OEIP — public architecture overview (marketing / standards)
%% Implementation / lab / lite diagrams live in private platform-iac-core/docs/internal/

flowchart TD
    classDef tierA fill:#2C3E50,stroke:#34495E,stroke-width:2px,color:#FFF
    classDef tierB fill:#D35400,stroke:#E67E22,stroke-width:2px,color:#FFF
    classDef tierC fill:#27AE60,stroke:#2ECC71,stroke-width:2px,color:#FFF
    classDef external fill:#7F8C8D,stroke:#95A5A6,stroke-width:2px,color:#FFF,stroke-dasharray:5 5

    Client["External Clients / B2B"]:::external
    Dev["Domain Developers"]:::external

    subgraph Platform["OEIP — Composable Architecture"]
        subgraph TierA["Tier A: Control Plane"]
            DevPortal["Experience<br/>Developer Portal"]:::tierA
            GitOps["Automation<br/>GitOps / CI"]:::tierA
            Obs["Observability<br/>OpenTelemetry + metrics/logs/traces"]:::tierA
        end

        subgraph TierB["Tier B: Replaceable Infrastructure"]
            Gateway["Edge<br/>API Gateway"]:::tierB
            IAM["Identity<br/>SSO / OIDC"]:::tierB
            Secrets["Secrets"]:::tierB
            Broker["Events<br/>Kafka-compatible"]:::tierB
            DBs["Persistence<br/>PostgreSQL (+ optional cache)"]:::tierB
            Registry["Container & schema registry"]:::tierB
        end

        subgraph TierC["Tier C: Customer Integration Logic"]
            IntEngine["Apache Camel<br/>thin routes"]:::tierC
            ProcEngine["Quarkus<br/>domain processing"]:::tierC
        end
    end

    Client ==> Gateway
    Dev -.-> DevPortal
    Dev -.-> GitOps
    Gateway ==> IAM
    Gateway ==> IntEngine
    IntEngine <--> Broker
    ProcEngine <--> Broker
    IntEngine <--> DBs
    ProcEngine <--> DBs
    Secrets -.-> TierC
    GitOps -.-> TierC
    TierC -.-> Obs
    TierB -.-> Obs
